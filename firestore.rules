rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == '5Uc5gT6JclWsAE6fLouHV8TRsVe2';
    }

    function validMessage() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'text', 'createdAt', 'threadId', 'sender'])
        && data.keys().hasOnly([
          'name', 'text', 'createdAt', 'threadId', 'sender', 'broadcastId'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.createdAt == request.time
        && data.threadId is string
        && data.threadId.size() > 0
        && data.threadId.size() <= 128
        && (
          (
            data.sender == 'user'
            && !data.keys().hasAny(['broadcastId'])
            && request.auth != null
            && request.auth.uid != '5Uc5gT6JclWsAE6fLouHV8TRsVe2'
            && data.threadId == request.auth.uid
            && exists(
              /databases/$(database)/documents/visitorNames/$(request.auth.uid)
            )
            && get(
              /databases/$(database)/documents/visitorNames/$(request.auth.uid)
            ).data.active == true
            && get(
              /databases/$(database)/documents/visitorNames/$(request.auth.uid)
            ).data.name == data.name
          )
          || (
            data.sender == 'owner'
            && isOwner()
            && data.name == 'Dark'
            && data.broadcastId is string
            && data.broadcastId.size() > 0
            && data.broadcastId.size() <= 128
            && data.threadId != '5Uc5gT6JclWsAE6fLouHV8TRsVe2'
            && exists(
              /databases/$(database)/documents/visitorNames/$(data.threadId)
            )
            && get(
              /databases/$(database)/documents/visitorNames/$(data.threadId)
            ).data.active == true
          )
        );
    }

    match /visitorNames/{uid} {
      allow get: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow list: if isOwner();
      allow create: if request.auth != null
        && (isOwner() || request.auth.uid == uid)
        && uid != '5Uc5gT6JclWsAE6fLouHV8TRsVe2'
        && request.resource.data.keys().hasOnly([
          'name', 'baseName', 'number', 'nameKey', 'uid', 'active', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.baseName is string
        && request.resource.data.baseName.size() > 0
        && request.resource.data.baseName.size() <= 100
        && request.resource.data.number is int
        && request.resource.data.number == 1
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey == uid
        && request.resource.data.baseName == request.resource.data.name
        && request.resource.data.name != '.'
        && request.resource.data.name != '..'
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;

      allow update: if (
          isOwner()
          && resource.data.active == true
          && request.resource.data.active == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        )
        || (
          request.auth != null
          && (isOwner() || request.auth.uid == uid)
          && resource.data.active == true
          && request.resource.data.active == true
          && request.resource.data.uid == uid
          && request.resource.data.baseName == resource.data.baseName
          && request.resource.data.name == resource.data.baseName
          && request.resource.data.number == 1
          && request.resource.data.nameKey == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'number', 'nameKey'])
        );
      allow delete: if isOwner();
    }

    match /visitorNameKeys/{nameKey} {
      allow get: if request.auth != null;
      allow list: if isOwner();
      allow create: if request.auth != null
        && (isOwner() || request.resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'name', 'baseName', 'number', 'uid', 'createdAt'
        ])
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 128
        && request.resource.data.uid != '5Uc5gT6JclWsAE6fLouHV8TRsVe2'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.baseName is string
        && request.resource.data.baseName.size() > 0
        && request.resource.data.baseName.size() <= 100
        && request.resource.data.number is int
        && request.resource.data.number >= 1
        && request.resource.data.createdAt == request.time
        && existsAfter(
          /databases/$(database)/documents/visitorNames/$(request.resource.data.uid)
        )
        && getAfter(
          /databases/$(database)/documents/visitorNames/$(request.resource.data.uid)
        ).data.name == request.resource.data.name
        && getAfter(
          /databases/$(database)/documents/visitorNames/$(request.resource.data.uid)
        ).data.baseName == request.resource.data.baseName
        && getAfter(
          /databases/$(database)/documents/visitorNames/$(request.resource.data.uid)
        ).data.number == request.resource.data.number
        && getAfter(
          /databases/$(database)/documents/visitorNames/$(request.resource.data.uid)
        ).data.nameKey == nameKey
        && getAfter(
          /databases/$(database)/documents/visitorNames/$(request.resource.data.uid)
        ).data.active == true;
      allow update: if false;
      allow delete: if isOwner();
    }

    match /threadReads/{threadId} {
      allow get, list: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['lastReadAt', 'updatedAt'])
        && request.resource.data.lastReadAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(['lastReadAt', 'updatedAt'])
        && request.resource.data.lastReadAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastReadAt', 'updatedAt']);
      allow delete: if isOwner();
    }

    match /typingStates/{threadId} {
      allow get: if isOwner() || (request.auth != null && request.auth.uid == threadId);
      allow list: if isOwner();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'visitorTyping', 'ownerTyping', 'updatedAt', 'visitorUpdatedAt', 'ownerUpdatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'visitorTyping', 'ownerTyping', 'updatedAt'
        ])
        && request.resource.data.visitorTyping is bool
        && request.resource.data.ownerTyping is bool
        && request.resource.data.updatedAt == request.time
        && exists(
          /databases/$(database)/documents/visitorNames/$(threadId)
        )
        && get(
          /databases/$(database)/documents/visitorNames/$(threadId)
        ).data.active == true
        && (
          (
            isOwner()
            && request.resource.data.visitorTyping == false
            && request.resource.data.ownerUpdatedAt == request.time
            && !request.resource.data.keys().hasAny(['visitorUpdatedAt'])
          )
          || (
            request.auth.uid == threadId
            && request.resource.data.ownerTyping == false
            && request.resource.data.visitorUpdatedAt == request.time
            && !request.resource.data.keys().hasAny(['ownerUpdatedAt'])
          )
        );
      allow update: if request.auth != null
        && request.resource.data.updatedAt == request.time
        && exists(
          /databases/$(database)/documents/visitorNames/$(threadId)
        )
        && get(
          /databases/$(database)/documents/visitorNames/$(threadId)
        ).data.active == true
        && (
          (
            isOwner()
            && request.resource.data.ownerTyping is bool
            && request.resource.data.ownerUpdatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ownerTyping', 'ownerUpdatedAt', 'updatedAt'])
          )
          || (
            request.auth.uid == threadId
            && request.resource.data.visitorTyping is bool
            && request.resource.data.visitorUpdatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['visitorTyping', 'visitorUpdatedAt', 'updatedAt'])
          )
        );
      allow delete: if isOwner();
    }

    match /messages/{messageId} {
      allow read: if isOwner()
        || (
          request.auth != null
          && resource.data.threadId == request.auth.uid
          && exists(
            /databases/$(database)/documents/visitorNames/$(request.auth.uid)
          )
          && get(
            /databases/$(database)/documents/visitorNames/$(request.auth.uid)
          ).data.active == true
        );
      allow create: if validMessage();
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
